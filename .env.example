# Copy to .env and supply secrets. Do not commit .env or data/*.
PORT=5050
PUBLIC_BASE_URL=http://localhost:5050
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
TARGET_COUNTRY=United States
# Generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
DASHBOARD_API_KEY=REPLACE_WITH_RANDOM_LONG_SECRET
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# The limits below are conservative internal safety limits, not Upwork's published maxima.
SEARCH_MINUTE_LIMIT=10
SEARCH_HOUR_LIMIT=100
SEARCH_DAY_LIMIT=500
SEARCH_MIN_GAP_MS=7000
# Disabled by design. This starter has no background job collector.
AUTOMATED_POLLING_ENABLED=false
